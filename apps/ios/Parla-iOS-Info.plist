<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Both names are LITERAL, not $(PRODUCT_NAME). PRODUCT_NAME here is the target name, "Parla-iOS", which
	     is a build-system detail that was reaching the user: CFBundleDisplayName was absent, so the Home Screen
	     fell back to CFBundleName and the app installed as "Parla-iOS". Both extensions already hardcode their
	     CFBundleDisplayName; the app was the one that was missed. PRODUCT_NAME itself must NOT be repurposed for
	     this — it also derives PRODUCT_MODULE_NAME, and the iOS test target does `@testable import Parla_iOS`. -->
	<key>CFBundleName</key>
	<string>Parla</string>
	<key>CFBundleDisplayName</key>
	<string>Parla</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Parla records your microphone only while you are dictating, and transcribes it on-device. Your audio never leaves your device.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.parla.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>parla</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.parla.viewTranscript</string>
	</array>
	<!-- iOS ships only via the App Store → a store build: freemium gate + StoreKit ON. Remove for a full dev build. -->
	<key>ParlaStoreBuild</key>
	<true/>
</dict>
</plist>
