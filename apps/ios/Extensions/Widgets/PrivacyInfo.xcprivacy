<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Parla Widgets extension (Live Activity / Dynamic Island + Home widget) — Apple Privacy Manifest.

  Reads a snapshot FILE from the App Group container (FileManager.containerURL + Data(contentsOf:)) —
  NOT UserDefaults, so no CA92.1. Links only WidgetKit / ActivityKit / SwiftUI + the Foundation-only
  Shared/ files (no ParlaCore). It uses NO required-reason APIs, does NO tracking, and collects NO
  data — an honest empty declaration.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array/>
</dict>
</plist>
