# XcodeGen-generated iOS Xcode project + entitlements — build artifacts; apps/ios/project.yml is the source of truth
apps/ios/*.xcodeproj
apps/ios/*.entitlements
apps/mac/*.xcodeproj
apps/mac/build/
# Derived data from the screenshot tooling (docs/_dev/screenshots.sh).
apps/ios/.shots/
apps/mac/*.entitlements

# iOS test fixtures — real Telegram voice notes; voice NEVER in git. Local-only; the decode test XCTSkips without them.
apps/ios/Tests/Fixtures/

# Private planning tree — product strategy, unreleased naming, business/tax notes. Never published.
# Also listed in .git/info/exclude, but that file is per-clone: this line is what survives a fresh clone.
docs/_dev/

# Generated speech fixtures for A/B accuracy measurement — large, reproducible via the scripts inside.
test-audio/
